# CardIQ — environment variables
# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# --- Required ---

# Neon serverless Postgres — https://neon.tech/
DATABASE_URL=postgresql://user:password@host/dbname

# Clerk auth — https://clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Anthropic — card identification and signal narratives
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Public base URL of the app (used in emails and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Pricing data ---

# eBay Developer Program — https://developer.ebay.com/
EBAY_APP_ID=YourApp-YourApp-PRD-...
EBAY_CERT_ID=PRD-...

# --- Billing (optional — subscription features are gated off without it) ---

# Stripe — https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (optional — alerts silently no-op without it) ---

# Resend — https://resend.com/
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alerts@yourdomain.com

# --- Enrichment (optional — falls back or switches off) ---

# BallDontLie player stats; omit to fall back to the public ESPN API
BALLDONTLIE_API_KEY=your-key-here

# NewsData.io player news; omit to disable news enrichment
NEWSDATA_API_KEY=pub_...

# --- Scheduled jobs ---

# Shared secret guarding /api/price-refresh, /api/signal-sweep and
# /api/signals/outcome-check. Set the same value as a repository Actions secret.
PRICE_REFRESH_SECRET=generate-a-long-random-string

# --- Local development only ---

# Optional path to a local agent folder for the fleet bridge integration.
# Leave unset; the bridge is skipped when absent.
# FLEET_DIR=
