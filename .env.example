# CardIQ — Required Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# eBay Developer Program — https://developer.ebay.com/
EBAY_APP_ID=YourApp-...
EBAY_CERT_ID=YourCert-...

# BallDontLie (NBA stats) — https://www.balldontlie.io/
# Optional: omit to fall back to ESPN public API
BALLDONTLIE_API_KEY=your-key-here

# NewsData.io (player news) — https://newsdata.io/
# Optional: news enrichment is disabled if not set
NEWSDATA_API_KEY=pub_...
